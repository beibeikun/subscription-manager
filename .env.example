INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters
APP_PORT=3000
BIND_ADDRESS=127.0.0.1
# Set true behind HTTPS reverse proxy
COOKIE_SECURE=false

# Optional LAN HTTPS (requires trusting the exported local CA on each device)
# LAN_HOST=192.168.1.100
# COMPOSE_PROFILES=lan-https
