{
  "name": "subscription-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "reset-password": "node --env-file-if-exists=.env --import tsx server/reset-password.ts",
    "init": "node scripts/init.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "test:e2e": "playwright test",
    "format": "prettier --write src server shared tests e2e scripts *.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.5",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-slot": "1.3.3",
    "@tanstack/react-query": "5.104.0",
    "adm-zip": "0.6.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "echarts": "6.1.0",
    "fastify": "5.12.5",
    "lucide-react": "0.544.0",
    "luxon": "3.7.2",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/adm-zip": "0.5.8",
    "@types/luxon": "3.7.5",
    "@types/node": "24.19.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
